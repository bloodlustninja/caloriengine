<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Caloriengine">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Isolated Standalone Quick Log Overlay Activity -->
        <activity
            android:name=".QuickLogActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.Caloriengine.TranslucentDialog"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <!-- 2x1 Quick Add Widget -->
        <receiver
            android:name=".widget.QuickAddWidgetProvider"
            android:exported="true"
            android:label="Quick Food Log Widget (2x1)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_add_info" />
        </receiver>

        <!-- 2x2 Metabolic HUD Widget -->
        <receiver
            android:name=".widget.MetabolicHudWidgetProvider"
            android:exported="true"
            android:label="Metabolic HUD Matrix Widget (2x2)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_metabolic_hud_info" />
        </receiver>

    </application>

</manifest>
