<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hud_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Top Telemetry Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/hud_app_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="CALORIENGINE"
            android:textColor="#00FF66"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hud_meal_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="[ LUNCH ]"
            android:textColor="#008837"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Net Calorie Progress Readout Above Waveform -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/hud_kcal_readout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="1,850 / 2,150 KCAL"
            android:textColor="#00FF66"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hud_waveform_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="[ SYNC OPTIMAL ]"
            android:textColor="#00FF66"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Expanded 42dp Dual Overlapping Synthesizer Waveform Canvas -->
    <ImageView
        android:id="@+id/hud_waveform_image"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="4dp"
        android:scaleType="fitXY"
        android:contentDescription="Biometric Overlapping Waveform" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Live Macro Telemetry Row (Positioned Right Above Action Buttons) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="#15000000"
        android:padding="3dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/hud_protein_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="P: 135G"
            android:textColor="#00FF66"
            android:textSize="8.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hud_carbs_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="C: 190G"
            android:textColor="#00FF66"
            android:textSize="8.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hud_fats_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="F: 52G"
            android:textColor="#00FF66"
            android:textSize="8.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/hud_quick_log_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_btn_bg"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingVertical="7dp"
            android:text="[ + QUICK LOG ]"
            android:textColor="#00FF66"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hud_open_app_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_btn_bg"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:paddingVertical="7dp"
            android:text="[ APP ]"
            android:textColor="#00FF66"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
