<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_root_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="24dp"
    android:background="@drawable/widget_bg"
    android:elevation="12dp"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header Prompt -->
    <TextView
        android:id="@+id/dialog_header_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="&gt; QUICK LOG // [ LUNCH ]"
        android:textColor="#00FF66"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dialog_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:text="ENTER INTAKE (E.G. 2 ROTI AND DAL):"
        android:textColor="#008837"
        android:textSize="10sp" />

    <!-- Input Field -->
    <EditText
        android:id="@+id/dialog_input_edit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/widget_btn_bg"
        android:fontFamily="monospace"
        android:hint="E.G. 200G CHICKEN OR 2 ROTI"
        android:textColorHint="#005522"
        android:imeOptions="actionDone"
        android:inputType="textCapCharacters"
        android:padding="12dp"
        android:textColor="#00FF66"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dialog_btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/widget_btn_bg"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="ABORT"
            android:textColor="#FF3344"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dialog_btn_submit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_btn_bg"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="[ LOG INTAKE ]"
            android:textColor="#00FF66"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
